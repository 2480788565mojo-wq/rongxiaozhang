#!/usr/bin/env bash
set -euo pipefail

# Usage: sudo rxz-ai on|off
# Installs as /usr/local/bin/rxz-ai on the production server.

ENV_FILE="${RXZ_ENV_FILE:-/opt/rongxiaozhang/backend/.env}"
SERVICE="${RXZ_SERVICE:-rongxiaozhang-api.service}"
HEALTH_URL="${RXZ_HEALTH_URL:-http://127.0.0.1:8000/api/v1/health}"
CONFIG_URL="${RXZ_CONFIG_URL:-http://127.0.0.1:8000/api/v1/config}"

if [[ "${EUID}" -ne 0 ]]; then
  echo "请使用 sudo：sudo rxz-ai on|off" >&2
  exit 1
fi

case "${1:-}" in
  on)  value="true" ;;
  off) value="false" ;;
  *)
    echo "用法：sudo rxz-ai on|off" >&2
    exit 2
    ;;
esac

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "找不到环境文件：${ENV_FILE}" >&2
  exit 1
fi

cp -a "${ENV_FILE}" "${ENV_FILE}.bak.ai"
if grep -q '^AI_FEATURES_ENABLED=' "${ENV_FILE}"; then
  sed -i "s/^AI_FEATURES_ENABLED=.*/AI_FEATURES_ENABLED=${value}/" "${ENV_FILE}"
else
  printf '\nAI_FEATURES_ENABLED=%s\n' "${value}" >> "${ENV_FILE}"
fi

echo "AI_FEATURES_ENABLED=${value}"
grep -n '^AI_FEATURES_ENABLED=' "${ENV_FILE}"

systemctl restart "${SERVICE}"
sleep 1

if ! systemctl is-active --quiet "${SERVICE}"; then
  echo "服务启动失败，请执行：journalctl -u ${SERVICE} -n 80 --no-pager" >&2
  exit 1
fi

echo "--- health ---"
curl -fsS "${HEALTH_URL}"
echo
echo "--- config ---"
curl -fsS "${CONFIG_URL}"
echo
