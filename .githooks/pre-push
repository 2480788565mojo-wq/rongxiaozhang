#!/bin/sh

# ============================================================
# pre-push hook — 推送成功后清理通行证
# push 成功后，删除旧的通行证，确保下一次 commit 需要重新检查
# ============================================================

PASS_FILE=".claude/.checks/pass"

# 读取推送的目标
# git push 时，标准输入格式：<local-ref> <local-oid> <remote-ref> <remote-oid>
while read local_ref local_oid remote_ref remote_oid; do
    # 推送成功后清理通行证
    if [ -f "$PASS_FILE" ]; then
        rm -f "$PASS_FILE"
        echo "  🧹 旧通行证已清理"
    fi
done

exit 0
