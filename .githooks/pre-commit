#!/bin/sh

# ============================================================
# pre-commit hook — 质量门禁检查
# 检测 .claude/.checks/pass 通行证是否存在
# 有 → 放行（保留通行证，可继续使用）
# 无 → 拒绝提交，提示先运行 gitcommit-agent
# ============================================================

PASS_FILE=".claude/.checks/pass"

if [ -f "$PASS_FILE" ]; then
    # 通行证存在，放行（不删除，等 push 成功后统一清理）
    exit 0
else
    # 无通行证，拒绝提交
    echo ""
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║                                                    ║"
    echo "║   ❌  提交被拒绝                                   ║"
    echo "║                                                    ║"
    echo "║   请先运行 gitcommit-agent                         ║"
    echo "║   它会自动执行单元测试和质量检查                    ║"
    echo "║   全部通过后颁发通行证，然后重新提交即可            ║"
    echo "║                                                    ║"
    echo "║   使用方式：                                       ║"
    echo "║     gitcommit-agent，帮我检查代码质量               ║"
    echo "║                                                    ║"
    echo "╚══════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi
